# ── Sanity ──────────────────────────────────────
# Get these from sanity.io/manage → your project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity write token (for contact form submissions)
# Create one at sanity.io/manage → API → Tokens → Add token (Editor role)
SANITY_API_WRITE_TOKEN=your_write_token

# ── Resend ───────────────────────────────────────
# Get from resend.com/api-keys
RESEND_API_KEY=re_your_resend_key

# Email address that receives lead notifications
CONTACT_RECIPIENT_EMAIL=hello@solartide.com
